\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces When a single pick-and-place manipulation is infeasible under given object poses $\mathbf  {T}_{\mathrm  {init}}$ and $\mathbf  {T}_{\mathrm  {goal}}$, a regrasp via an intermediate pose $\mathbf  {T}_{\mathrm  {mid}}$ (yellow) is required. We propose a \textit  {pose connectivity} score $Q_{p}(\mathbf  {T}_a, \mathbf  {T}_b)$ and a differentiable \textit  {pose sequence} cost $J_{s}(\mathcal  {T}_{\mathrm  {mid}})$ based on EBMs to generate an optimal intermediate pose $\mathbf  {T}_{\mathrm  {mid}}$ by following the gradient $\nabla _{\mathbf  {T}_{\mathrm  {mid}}}J_s$. This facilitates the construction of a valid object reorientation sequence bridging the $\mathbf  {T}_{\mathrm  {init}}$ and $\mathbf  {T}_{\mathrm  {goal}}$, enabling multi-step pick-and-place planning.\footnotemark [1]}}{1}{figure.1}\protected@file@percent }
\newlabel{fig_1}{{1}{1}{When a single pick-and-place manipulation is infeasible under given object poses $\mathbf {T}_{\mathrm {init}}$ and $\mathbf {T}_{\mathrm {goal}}$, a regrasp via an intermediate pose $\mathbf {T}_{\mathrm {mid}}$ (yellow) is required. We propose a \textit {pose connectivity} score $Q_{p}(\mathbf {T}_a, \mathbf {T}_b)$ and a differentiable \textit {pose sequence} cost $J_{s}(\mathcal {T}_{\mathrm {mid}})$ based on EBMs to generate an optimal intermediate pose $\mathbf {T}_{\mathrm {mid}}$ by following the gradient $\nabla _{\mathbf {T}_{\mathrm {mid}}}J_s$. This facilitates the construction of a valid object reorientation sequence bridging the $\mathbf {T}_{\mathrm {init}}$ and $\mathbf {T}_{\mathrm {goal}}$, enabling multi-step pick-and-place planning.\protect \footnotemark [1]}{figure.1}{}}
