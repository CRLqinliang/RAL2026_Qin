\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Optimization \uline {process}{\color  {darkgreen}\begin  {CJK*}{UTF8}{gkai}\relax \fontsize  {9}{10pt}\selectfont  result\end  {CJK*}} with the bottle object. (a) Five stable poses. (b) Evolution of the energy landscape during optimization (Blue: low energy/high connectivity). (c) Comparison of generated {\color  {darkgreen}\begin  {CJK*}{UTF8}{gkai}\relax \fontsize  {9}{10pt}\selectfont  object\end  {CJK*}} pose distributions, {\color  {darkgreen}\begin  {CJK*}{UTF8}{gkai}\relax \fontsize  {9}{10pt}\selectfont  the arrow provides a 2D visualization of each intermediate pose $\mathbf  {T}_{\mathrm  {mid}}$, originating at $(x, y)$ and pointing along the planar yaw $\theta $ in $\bm  {\xi }=[x,y,\theta ]^\top $, i.e., $(\cos \theta , \sin \theta )$; arrow color indicates pose cost (energy), with red for high energy and blue for low energy, consistent with the color bar. In the actual evaluation, the full 3D pose is used, with $z$-height and base orientation from the stable placement $\mathbf  {T}_{\mathrm  {s}}^{(m)}$ and in-plane rotation $\mathbf  {R}_z(\theta )$ (Eq.~\ref {eq_ensemble_init}).\end  {CJK*}}: (i) Ground Truth (GT) feasible regions obtained via exhaustive grid sampling; (ii-iii) Results from the naive cost $J^{+}_{s}$ and the truncated cost $J^{h}_{s}$, respectively. (iv) Results of the proposed cost $J_{s}$.{\color  {red}\begin  {CJK*}{UTF8}{gkai}\relax \fontsize  {9}{10pt}\selectfont  每个图是优化的第几步？为什么是pose相关，箭头方向表示什么？颜色表示能量应明确说明。\end  {CJK*}} {\color  {darkgreen}\begin  {CJK*}{UTF8}{gkai}\relax \fontsize  {9}{10pt}\selectfont  1. (c)的图都是优化的结果，即最后一步。 2.好的，关于箭头和能量的颜色的说明在图中的caption增加了。\end  {CJK*}}}}{7}{figure.6}\protected@file@percent }
\newlabel{fig_one_step_exp}{{6}{7}{Optimization \uline {process}\lqin {result} with the bottle object. (a) Five stable poses. (b) Evolution of the energy landscape during optimization (Blue: low energy/high connectivity). (c) Comparison of generated \lqin {object} pose distributions, \lqin {the arrow provides a 2D visualization of each intermediate pose $\mathbf {T}_{\mathrm {mid}}$, originating at $(x, y)$ and pointing along the planar yaw $\theta $ in $\boldsymbol {\xi }=[x,y,\theta ]^\top $, i.e., $(\cos \theta , \sin \theta )$; arrow color indicates pose cost (energy), with red for high energy and blue for low energy, consistent with the color bar. In the actual evaluation, the full 3D pose is used, with $z$-height and base orientation from the stable placement $\mathbf {T}_{\mathrm {s}}^{(m)}$ and in-plane rotation $\mathbf {R}_z(\theta )$ (Eq.~\ref {eq_ensemble_init}).}: (i) Ground Truth (GT) feasible regions obtained via exhaustive grid sampling; (ii-iii) Results from the naive cost $J^{+}_{s}$ and the truncated cost $J^{h}_{s}$, respectively. (iv) Results of the proposed cost $J_{s}$.\wan {每个图是优化的第几步？为什么是pose相关，箭头方向表示什么？颜色表示能量应明确说明。} \lqin {1. (c)的图都是优化的结果，即最后一步。 2.好的，关于箭头和能量的颜色的说明在图中的caption增加了。}}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Dataset overview: (a) Four representative object shapes (Bottle, Bunny, Pentagon, Mug) and their table-stable placement poses. (b) Pre-sampled grasp candidates set $\mathcal  {G}$ for six different end-effectors (three parallel grippers: WRS3, Robotiq-140/85; three suction cups: SC, VPA, ZP3) on different objects, used for cross-validation experiments to evaluate transferability across hardware configurations.{\color  {darkgreen}\begin  {CJK*}{UTF8}{gkai}\relax \fontsize  {9}{10pt}\selectfont  这个图是要如何修改来着？\end  {CJK*}}{\color  {red}\begin  {CJK*}{UTF8}{gkai}\relax \fontsize  {9}{10pt}\selectfont  机器人的存在是否有意义？手抓不同比例尺是误导。\end  {CJK*}} {\color  {babyblue}\begin  {CJK*}{UTF8}{gkai}\relax \fontsize  {9}{10pt}\selectfont  把手爪的图片进行了修改，用机械臂来做参照物来看各个末端执行器放的相对大小情况。\end  {CJK*}}}}{7}{figure.7}\protected@file@percent }
\newlabel{fig_unseen_exp}{{7}{7}{Dataset overview: (a) Four representative object shapes (Bottle, Bunny, Pentagon, Mug) and their table-stable placement poses. (b) Pre-sampled grasp candidates set $\mathcal {G}$ for six different end-effectors (three parallel grippers: WRS3, Robotiq-140/85; three suction cups: SC, VPA, ZP3) on different objects, used for cross-validation experiments to evaluate transferability across hardware configurations.\lqin {这个图是要如何修改来着？}\wan {机器人的存在是否有意义？手抓不同比例尺是误导。} \lqinextra {把手爪的图片进行了修改，用机械臂来做参照物来看各个末端执行器放的相对大小情况。}}{figure.7}{}}
