{
  // 1. Ctrl+S 保存时自动编译 PDF
  "latex-workshop.latex.autoBuild.run": "onSave",

  // 2. .tex 文件自动换行
  "[tex]": { "editor.wordWrap": "on" },
  "[latex]": { "editor.wordWrap": "on" },

  // 3. PDF 阅读器设置
  "latex-workshop.view.pdf.viewer": "tab",
  
  // 4. SyncTeX (跳转) 关键设置
  "latex-workshop.synctex.afterBuild.enabled": true,
  // 设置为双击跳转 (也可以改为 "ctrl-click")
  "latex-workshop.pdf.internal.synctex.keybinding": "double-click",

  // 5. 显式配置编译工具，确保开启 synctex
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ],
      "env": {}
    }
  ]
}
